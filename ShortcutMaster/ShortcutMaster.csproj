<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>shortcut</AssemblyName>
    <RootNamespace>ShortcutMaster</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>shortcut</ToolCommandName>
    <PackageId>ShortcutMaster</PackageId>
    <Version>1.0.0</Version>
    <Description>Personal command shortcuts for PowerShell, CMD, Bash and Zsh.</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>
